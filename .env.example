# =====================================================
# ArcksCare Backend - Environment Variables
# Copy this file to `.env` and fill in real values.
# =====================================================

# ---- Database ----
# Local dev (zero-setup): SQLite
DATABASE_URL=sqlite:///./arckscare.db
# Production (Supabase): postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ---- SMTP / Email ----
# Use a Gmail account with an "App Password" (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=ArcksCare Support
SMTP_FROM_EMAIL=your-gmail@gmail.com

# Where ticket notifications are sent
SUPPORT_INBOX=support@test.com

# ---- App ----
APP_NAME=ArcksCare
APP_ENV=development
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Business rules ----
DUPLICATE_WINDOW_HOURS=48

# ---- File storage (Phase 1: local; Phase 2: switch to supabase) ----
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads
