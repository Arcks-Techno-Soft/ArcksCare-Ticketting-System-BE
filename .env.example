# =====================================================
# SK-POS Support Backend - Environment Variables (TEMPLATE)
# Copy this file to `.env` and fill in real values there.
# `.env` is gitignored; `.env.example` is committed - so KEEP PLACEHOLDERS HERE.
# =====================================================

# ---- Database ----
# Pick ONE of the two below.

# Option A — Local dev (zero-setup): SQLite
DATABASE_URL=sqlite:///./sk-pos-care.db

# Option B — Supabase Postgres (recommended once you start running tickets)
# Get the connection string from your Supabase project: Connect → URI (direct)
# Then prefix the scheme with `+psycopg` so SQLAlchemy uses the psycopg3 driver.
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# For deployed environments (Render etc.), prefer the Supavisor pooler URL on port 6543.

# ---- SMTP / Email ----
# Use a Gmail account with an "App Password" (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_NAME=SK-POS Support Support
SMTP_FROM_EMAIL=your-gmail@gmail.com

# Where ticket notifications are sent
SUPPORT_INBOX=support@yourdomain.com

# ---- App ----
APP_NAME=SK-POS Support
# Use "production" for any live deployment. In production the app REFUSES to
# start unless JWT_SECRET is strong (>=32 chars, not the placeholder), the
# demo engineer logins are not seeded, and the fake demo tickets are not loaded.
APP_ENV=development
# Comma-separated list of allowed frontend origins for CORS (no trailing slash, no path).
# In production this MUST include EVERY origin a browser loads the form from —
# the live custom domain AND any Vercel URL. If an origin is missing, the
# browser blocks the (successful) response and the user sees "Failed to fetch"
# even though the ticket was created. Example:
#   https://sk-pos-care.sktechnosys.in,https://arcks-care-ticketting-system-fe.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public base URL of the FRONTEND, used to build customer/off-field signing
# links (/sign, /field-sign, /sign-install). MUST be the deployed frontend
# origin in production — otherwise generated links point at localhost.
# Production value: https://sk-pos-care.sktechnosys.in
CUSTOMER_SIGN_URL_BASE=http://localhost:3000

# ---- Business rules ----
DUPLICATE_WINDOW_HOURS=48

# ---- File storage ----
# Set STORAGE_BACKEND to "local" for laptop dev, or "supabase" / "s3" for cloud storage.
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads

# Supabase Storage (only used when STORAGE_BACKEND=supabase)
# Get these from your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=sk-pos-care-uploads
# How long signed URLs in support emails stay valid (seconds). Default: 7 days.
SUPABASE_SIGNED_URL_TTL_SECONDS=604800

# Amazon S3 (only used when STORAGE_BACKEND=s3)
# Use a dedicated IAM user's keys scoped to this bucket — instance-role temp
# credentials cap presigned URLs at ~6 h instead of the 7-day TTL below.
S3_BUCKET=arckscare-uploads-prod
S3_REGION=ap-south-1
S3_SIGNED_URL_TTL_SECONDS=604800
AWS_ACCESS_KEY_ID=your-iam-user-access-key
AWS_SECRET_ACCESS_KEY=your-iam-user-secret-key

# ---- WhatsApp notifications via Twilio ----
# Optional staff WhatsApp alerts: new ticket -> owners/admins/managers,
# assignment -> assigned engineer. The service is a SILENT NO-OP while any of
# ACCOUNT_SID / AUTH_TOKEN / WHATSAPP_FROM is blank, so the app deploys cleanly
# before Twilio is configured. KEEP PLACEHOLDERS HERE (this file is committed).
#
# SID + token: Twilio Console dashboard -> https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Sender = approved WhatsApp Business number in E.164 with a whatsapp: prefix,
# e.g. whatsapp:+919606945752  (or the Sandbox number whatsapp:+14155238886).
TWILIO_WHATSAPP_FROM=whatsapp:+910000000000
# Approved WhatsApp template SIDs (HX...). REQUIRED for production senders to
# reach staff outside the 24h reply window. Blank = plain text (Sandbox only).
# CONTENT_SID = new-ticket alert (owners/managers); ASSIGNMENT = engineer alert.
TWILIO_CONTENT_SID=
TWILIO_ASSIGNMENT_CONTENT_SID=
# Base URL for the ticket link in the message body (falls back to first CORS origin).
WHATSAPP_LINK_BASE=https://sk-pos-care.sktechnosys.in

# ---- Upcoming-installation reminder ----
# WhatsApps Super Admin / Admin / Managers ahead of an installation's
# expected_installation_date. Off by default; enable on ONE instance only.
INSTALL_REMINDER_SCHEDULER_ENABLED=false
# How often the loop wakes up (seconds) — date-based, so a slow tick is fine.
INSTALL_REMINDER_TICK_SECONDS=900
# Days ahead of the expected date the reminder goes out.
INSTALL_REMINDER_DAYS_BEFORE=2
# Earliest local hour (24h) a reminder may be sent, so a late-night create
# can't wake anyone up. Evaluated in INSTALL_REMINDER_TIMEZONE.
INSTALL_REMINDER_SEND_AFTER_HOUR=9
INSTALL_REMINDER_TIMEZONE=Asia/Kolkata
# Approved template SID. {{1}}..{{5}} = reference, customer, expected date,
# when-phrase, engineer. Blank = plain text (Sandbox only).
TWILIO_INSTALL_UPCOMING_CONTENT_SID=

# ---- Auth (Phase 2.1+) ----
# REQUIRED in production. Generate a long random string and keep it secret —
# anyone who knows it can forge an Owner login. Example:
#   openssl rand -hex 32
#   (or)  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Rotating this value invalidates all existing sessions (everyone re-logs in).
JWT_SECRET=change-me-in-production-this-must-be-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=24

# Seed users (auto-created ONLY on first boot of an empty `users` table).
# In production these MUST NOT be the weak defaults below — the app refuses to
# seed weak passwords. They do nothing on a database that already has users;
# to fix already-seeded weak accounts use scripts/rotate_passwords.py.
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=owner123
SEED_OWNER_NAME=Owner
SEED_MANAGER_USERNAME=admin
SEED_MANAGER_PASSWORD=admin123
SEED_MANAGER_NAME=Manager
