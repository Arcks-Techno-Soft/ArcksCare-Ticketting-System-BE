# =====================================================
# SK-POS Support Backend - Environment Variables (TEMPLATE)
# Copy this file to `.env` and fill in real values there.
# `.env` is gitignored; `.env.example` is committed - so KEEP PLACEHOLDERS HERE.
# =====================================================

# ---- Database ----
# Pick ONE of the two below.

# Option A — Local dev (zero-setup): SQLite
DATABASE_URL=sqlite:///./sk-pos-care.db

# Option B — Supabase Postgres (recommended once you start running tickets)
# Get the connection string from your Supabase project: Connect → URI (direct)
# Then prefix the scheme with `+psycopg` so SQLAlchemy uses the psycopg3 driver.
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# For deployed environments (Render etc.), prefer the Supavisor pooler URL on port 6543.

# ---- SMTP / Email ----
# Use a Gmail account with an "App Password" (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_NAME=SK-POS Support Support
SMTP_FROM_EMAIL=your-gmail@gmail.com

# Where ticket notifications are sent
SUPPORT_INBOX=support@yourdomain.com

# ---- App ----
APP_NAME=SK-POS Support
# Use "production" for any live deployment. In production the app REFUSES to
# start unless JWT_SECRET is strong (>=32 chars, not the placeholder), the
# demo engineer logins are not seeded, and the fake demo tickets are not loaded.
APP_ENV=development
# Comma-separated list of allowed frontend origins for CORS (no trailing slash, no path).
# In production this MUST include your deployed frontend origin, e.g.:
#   https://sk-pos-care.sktechnosys.in,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public base URL of the FRONTEND, used to build customer/off-field signing
# links (/sign, /field-sign, /sign-install). MUST be the deployed frontend
# origin in production — otherwise generated links point at localhost.
# Production value: https://sk-pos-care.sktechnosys.in
CUSTOMER_SIGN_URL_BASE=http://localhost:3000

# ---- Business rules ----
DUPLICATE_WINDOW_HOURS=48

# ---- File storage ----
# Set STORAGE_BACKEND to "local" for laptop dev, or "supabase" for cloud storage.
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads

# Supabase Storage (only used when STORAGE_BACKEND=supabase)
# Get these from your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=sk-pos-care-uploads
# How long signed URLs in support emails stay valid (seconds). Default: 7 days.
SUPABASE_SIGNED_URL_TTL_SECONDS=604800

# ---- Auth (Phase 2.1+) ----
# REQUIRED in production. Generate a long random string and keep it secret —
# anyone who knows it can forge an Owner login. Example:
#   openssl rand -hex 32
#   (or)  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Rotating this value invalidates all existing sessions (everyone re-logs in).
JWT_SECRET=change-me-in-production-this-must-be-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=24

# Seed users (auto-created ONLY on first boot of an empty `users` table).
# In production these MUST NOT be the weak defaults below — the app refuses to
# seed weak passwords. They do nothing on a database that already has users;
# to fix already-seeded weak accounts use scripts/rotate_passwords.py.
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=owner123
SEED_OWNER_NAME=Owner
SEED_MANAGER_USERNAME=admin
SEED_MANAGER_PASSWORD=admin123
SEED_MANAGER_NAME=Manager
